# Copy this file to `android/key.properties` and fill in your real values.
# android/key.properties is gitignored — NEVER commit it or the keystore.
#
# storeFile: absolute path to your keystore is safest, e.g.
#   storeFile=C:/Users/Admin/keys/upload.jks   (use forward slashes on Windows)
# or a path relative to android/app/ (e.g. storeFile=upload.jks).

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=C:/path/to/upload.jks
