rules_version = '2';

// Навици (navici-1969) — cloud backup/sync for optional accounts.
// Each signed-in user may read/write ONLY their own document at users/{uid}.
// Deploy: Firebase Console → Firestore Database → Rules → paste → Publish
// (or `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else denied by default.
  }
}
