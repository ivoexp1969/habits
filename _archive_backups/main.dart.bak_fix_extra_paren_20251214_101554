  Future<void> _loadHabits() async {
    final prefs = await SharedPreferences.getInstance();
    final jsonString = prefs.getString(kPrefsHabits);
    if (jsonString == null) {
      setState(() {
        _habits = _defaultHabits();
      });
      
      await _refreshSmartReminders();
await _refreshSmartReminders();
      
      return;
    }

    try {
      final List<dynamic> data = jsonDecode(jsonString) as List<dynamic>;
      final loaded = data
          .map((e) => Habit.fromJson(e as Map<String, dynamic>))
          .toList();
      setState(() {
        _habits = loaded;
      });
    
      await _refreshSmartReminders();
} catch (_) {
      setState(() {
        _habits = _defaultHabits();
      });
    
      await _refreshSmartReminders();
}
  }

  double get _dayProgress {
    if (_habits.isEmpty) return 0;
    final total = _habits.fold<double>(
      0,
      (sum, h) => sum + h.progress,
    );
    return total / _habits.length;
  }

  Future<void> _saveHabits() async {
    final prefs = await SharedPreferences.getInstance();
    final data = _habits.map((h) => h.toJson()).toList();
    await prefs.setString(kPrefsHabits, jsonEncode(data));

    // запазваме и дневната история (общ %)
    final now = DateTime.now();
    final key = dateKeyFromDate(now);
    final historyStr = prefs.getString(kPrefsHistory);
    Map<String, dynamic> history = {};
    if (historyStr != null) {
      try {
        history = jsonDecode(historyStr) as Map<String, dynamic>;
      } catch (_) {
        history = {};
      }
    }
    history[key] = (_dayProgress * 100);
    await prefs.setString(kPrefsHistory, jsonEncode(history));
  }

  Color _nextColorForNewHabit() {
    final used = _habits
        .map((h) => h.color?.value)
        .whereType<int>()
        .toSet();

    for (final c in _palette) {
      if (!used.contains(c.value)) return c;
    }
    return _palette[_habits.length % _palette.length];
  }

