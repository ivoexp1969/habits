// -------------------- NOTIFICATION SERVICE --------------------
const String kPrefsHabits = 'habits';
class NotificationService {
  Future<void> cancelAllNotifications() async {
    await notificationsPlugin.cancelAll();
  }

  NotificationService._internal();

  static final NotificationService _instance = NotificationService._internal();

  factory NotificationService() => _instance;

  bool _initialized = false;

  Future<void> init() async {
    if (_initialized) return;

    tz.initializeTimeZones();
    tz.setLocalLocation(tz.getLocation('Europe/Sofia'));

    const androidInit = AndroidInitializationSettings('@mipmap/ic_launcher');
    const initSettings = InitializationSettings(android: androidInit);

    await notificationsPlugin.initialize(initSettings);

    
    const AndroidNotificationChannel smartLoudChannel =
        AndroidNotificationChannel(
      'smart_loud',
      'Smart reminders (loud)',
      description: 'Интелигентни напомняния със звук',
      importance: Importance.max,
      playSound: true,
      enableVibration: true,
    );

    const AndroidNotificationChannel smartSilentChannel =
        AndroidNotificationChannel(
      'smart_silent',
      'Smart reminders (silent)',
      description: 'Интелигентни напомняния без звук',
      importance: Importance.low,
      playSound: false,
      enableVibration: false,
    );

    final androidPlugin =
        notificationsPlugin.resolvePlatformSpecificImplementation<
            AndroidFlutterLocalNotificationsPlugin>();

    await androidPlugin?.createNotificationChannel(smartLoudChannel);
    await androidPlugin?.createNotificationChannel(smartSilentChannel);
final androidImpl =
        notificationsPlugin.resolvePlatformSpecificImplementation<
            AndroidFlutterLocalNotificationsPlugin>();
    await androidImpl?.requestNotificationsPermission();

    _initialized = true;
  }

  /// Еднократна тестова нотификация след 10 секунди.
  Future<void> showTestNotificationAfterTenSeconds() async {
    final androidDetails = AndroidNotificationDetails('smart_loud',
      'Test notifications',
      channelDescription: 'Тестови нотификации за навици',
      importance: Importance.max,
      priority: Priority.high,
    );

    final details = NotificationDetails(android: androidDetails);

    final scheduledDate =
        tz.TZDateTime.now(tz.local).add(const Duration(seconds: 10));

    await notificationsPlugin.zonedSchedule(
      DateTime.now().millisecondsSinceEpoch.remainder(100000),
      'Тест нотификация',
      'Тази нотификация дойде 10 секунди след бутона, дори и приложението да е затворено.',
      scheduledDate,
      details,
      androidScheduleMode: AndroidScheduleMode.exactAllowWhileIdle,
    );
  }

  /// Ежедневно напомняне – в зададен час (override-ва предишни дневни).
  Future<void> scheduleDailyReminderAt(TimeOfDay time) async {
    final now = tz.TZDateTime.now(tz.local);

    var scheduled = tz.TZDateTime(
      tz.local,
      now.year,
      now.month,
      now.day,
      time.hour,
      time.minute,
    );

    if (scheduled.isBefore(now)) {
      scheduled = scheduled.add(const Duration(days: 1));
    }

    final androidDetails = AndroidNotificationDetails('smart_loud',
      'Daily habit reminders',
      channelDescription: 'Ежедневни напомняния за навици',
      importance: Importance.max,
      priority: Priority.high,
    );

    final details = NotificationDetails(android: androidDetails);

    await notificationsPlugin.zonedSchedule(
      2000,
      'Ежедневен преглед на навиците',
      'Маркирай какво изпълни днес.',
      scheduled,
      details,
      androidScheduleMode: AndroidScheduleMode.exactAllowWhileIdle,
      matchDateTimeComponents: DateTimeComponents.time,
    );
  }

  Future<void> cancelDailyReminder() async {
    await notificationsPlugin.cancel(2000);
  }

  /// Умни напомняния за днес – за недовършените навици.
  Future<void> scheduleSmartRemindersForToday(List<Habit> habits) async {
    final now = tz.TZDateTime.now(tz.local);

    // 4) silent vs loud (profile)
    final prefs = await SharedPreferences.getInstance();
    final profileStr = prefs.getString(kPrefsProfile);
    bool isSilent = false; // default: loud
    if (profileStr != null) {
      try {
        final data = jsonDecode(profileStr) as Map<String, dynamic>;
        isSilent = data['smartRemindersSilent'] as bool? ?? false;
      } catch (_) {}
    }
    // 1) Only unfinished habits
    final incomplete = habits
        .where((h) => h.timesPerDay > 0 && h.completedTimes < h.timesPerDay)
        .toList();

    // Clean old smart ids (we manage only these)
    for (var id = 3100; id <= 3110; id++) {
      await notificationsPlugin.cancel(id);
    }

    if (incomplete.isEmpty) return;

    // 2) Cooldown + Max per day (simple, deterministic)
    const maxPerDay = 3;
    const cooldownMinutes = 90;

    // pick up to 3 reminders, spaced by cooldown
    final times = <tz.TZDateTime>[];
    var t = now.add(const Duration(minutes: 15));
    for (var i = 0; i < maxPerDay; i++) {
      times.add(t);
      t = t.add(const Duration(minutes: cooldownMinutes));
    }

    // 3) Grouping (Android will bundle them)
    final androidDetails = AndroidNotificationDetails(isSilent ? 'smart_silent' : 'smart_loud',
      'Smart habit reminders',
      channelDescription: 'Интелигентни напомняния за навици',
      importance: Importance.max,
      priority: Priority.high,
      groupKey: 'habit_smart_group',
      setAsGroupSummary: false,
      groupAlertBehavior: GroupAlertBehavior.all,
    );
    final details = NotificationDetails(android: androidDetails);

    // Schedule: 1 reminder per top unfinished habit (up to maxPerDay)
    final count = incomplete.length < maxPerDay ? incomplete.length : maxPerDay;

    for (var i = 0; i < count; i++) {
      final h = incomplete[i];
      final remaining = (h.timesPerDay - h.completedTimes).clamp(1, 999);

      await notificationsPlugin.zonedSchedule(
        3100 + i,
        "Напомняне: ${h.name}",
        "Остават ти още $remaining за днес.",
        times[i],
        details,
        androidScheduleMode: AndroidScheduleMode.exactAllowWhileIdle,
      );
    }
  }

  Future<void> cancelAll() async {
    await notificationsPlugin.cancelAll();
  }
  Future<void> scheduleMidnightRescheduleTrigger() async {
    // Daily trigger at 00:00 local time to reschedule smart reminders for the new day
    final now = tz.TZDateTime.now(tz.local);
    var next = tz.TZDateTime(tz.local, now.year, now.month, now.day);
    if (!next.isAfter(now)) {
      next = next.add(const Duration(days: 1));
    }

    // Use a dedicated id outside smart range
    const int midnightId = 3999;

    final androidDetails = AndroidNotificationDetails(
      'smart_silent',
      'Smart reminders (silent)',
      channelDescription: 'Интелигентни напомняния без звук',
      importance: Importance.low,
      priority: Priority.low,
      playSound: false,
      enableVibration: false,
    );
    final details = NotificationDetails(android: androidDetails);

    await notificationsPlugin.zonedSchedule(
      midnightId,
      '',
      '',
      next,
      details,
      payload: 'MIDNIGHT_RESCHEDULE',
      androidScheduleMode: AndroidScheduleMode.exactAllowWhileIdle,
    );
  }

}

